{
  "info": {
    "name": "PRTG Bot Notif - WA API",
    "description": "Kumpulan API untuk mengirim pesan WhatsApp menggunakan Baileys (Context 7)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Kirim Pesan Teks",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "akucintasagiri",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"6281234567890\",\n  \"text\": \"Halo! Ini adalah pesan teks biasa dari API.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/whatsapp/send",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "whatsapp",
            "send"
          ]
        }
      }
    },
    {
