datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PrtgCookie {
  id        Int          @id @default(autoincrement())
  label     String?
  value     String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  configs   PrtgConfig[]
}

model PrtgSetting {
  id                     Int      @id @default(1)
  loginUrl               String   @default("http://prtg.r1net.id/index.htm")
  loginUsername          String?
  loginPassword          String?
  messageTemplate        String   @default("{title}\nGroup: {groupname}")
  alertMessageTemplate   String   @default("⚠️ {status} — {title}\nGroup: {groupName}\nWaktu: {time}\nAlasan: {reason}")
  recoveryMessageTemplate String  @default("✅ Pulih — {title}\nGroup: {groupName}\nWaktu: {time}")
  receiptMessageTemplate  String  @default("*{title}*\nGROUP : {groupName}\n{details}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

/// Logical grouping of PRTG charts. PrtgConfig and PrtgSchedule reference this.
model PrtgGroup {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique
  enabled              Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  configs              PrtgConfig[]
  schedules            PrtgSchedule[]
  receiptSchedules     ReceiptSchedule[]
  recipients           PrtgRecipient[]
  monitoringRecipients MonitoringRecipient[]
  receiptRecipients    ReceiptRecipient[]
}

model PrtgConfig {
  id         Int         @id @default(autoincrement())
  title      String
  sensorId   Int         @unique
  groupId    Int
  group      PrtgGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  enabled    Boolean     @default(true)
  cookieId   Int?
  cookie     PrtgCookie? @relation(fields: [cookieId], references: [id], onDelete: SetNull)

  // ─── Monitoring Fields ───
  monitoringEnabled Boolean        @default(false)
  pollingInterval   Int            @default(60)     // seconds, min 30
  thresholdLow      Float          @default(30.0)   // % below rolling avg
  thresholdHigh     Float          @default(90.0)   // utilization %
  sensitivity       NocSensitivity @default(MEDIUM)
  cooldownInterval  Int            @default(300)    // seconds
  noTrafficCount    Int            @default(3)      // consecutive intervals
  flappingWindow    Int            @default(600)    // seconds
  flappingCount     Int            @default(4)      // transitions in window
  downCount         Int            @default(3)      // consecutive errors
  rollingWindowSize Int            @default(10)     // number of samples
  notifyDown        Boolean        @default(true)
  notifyNoTraffic   Boolean        @default(true)
  notifyLowTraffic  Boolean        @default(true)
  notifyFlapping    Boolean        @default(true)
  notifyRecovery    Boolean        @default(true)
  maintenance       Boolean        @default(false)
  maintenanceLabel  String?        // e.g. "Maintenance", "Mati Lampu", or null if not in maintenance
  minTrafficThreshold Float        @default(10.0)  // Mbit/s — minimum traffic to consider "recovered" when no baseline
  lastPolledAt      DateTime?
  lastStatus        NocStatus      @default(NORMAL)

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  history    MonitoringHistory[]
}

model PrtgRecipient {
  id          Int                 @id @default(autoincrement())
  label       String?
  phoneNumber String
  targetType  RecipientTargetType @default(manual)
  enabled     Boolean             @default(true)
  isAdmin     Boolean             @default(false)
  /// null = applies to ALL groups (sent with every dispatch)
  groupId     Int?
  group       PrtgGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

/// Monitoring-specific recipients — hanya menerima notifikasi alert monitoring (DOWN, recovery, dll)
/// Terpisah dari PrtgRecipient yang digunakan untuk report schedule.
model MonitoringRecipient {
  id          Int                 @id @default(autoincrement())
  label       String?
  phoneNumber String
  targetType  RecipientTargetType @default(manual)
  enabled     Boolean             @default(true)
  /// null = applies to ALL groups (receives alerts for all monitoring configs)
  groupId     Int?
  group       PrtgGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

/// Recipient khusus untuk notifikasi ping monitoring.
/// Dipisahkan dari MonitoringRecipient agar alert PRTG/NOC dan ping punya jalur sendiri.
model PingRecipient {
  id          Int                 @id @default(autoincrement())
  label       String?
  phoneNumber String
  targetType  RecipientTargetType @default(manual)
  enabled     Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  pingMonitors PingMonitorRecipient[]
}

enum PingMonitorStatus {
  UNKNOWN
  UP
  RTO
}

model PingMonitor {
  id                  Int               @id @default(autoincrement())
  name                String
  host                String            @unique
  enabled             Boolean           @default(true)
  intervalSeconds     Int               @default(2)
  pingTimeoutSeconds  Int               @default(1)
  rtoThresholdSeconds Int               @default(10)
  notificationCooldownSeconds Int       @default(3600)
  maintenance         Boolean           @default(false)
  maintenanceLabel    String?
  notifyRecovery      Boolean           @default(true)
  alertTemplate       String            @default("*ALERT RTO*\n{label} ({host}) mengalami RTO dalam {outageSeconds} detik yang lalu.\nWaktu: {time}")
  recoveryTemplate    String            @default("*PULIH*\n{label} ({host}) kembali terhubung.\nLatency: {latencyMs} ms\nWaktu: {time}")
  status              PingMonitorStatus @default(UNKNOWN)
  lastLatencyMs       Float?
  lastCheckedAt       DateTime?
  outageStartedAt     DateTime?
  lastAlertAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  recipients          PingMonitorRecipient[]
}

model PingMonitorRecipient {
  pingMonitorId  Int
  pingRecipientId Int
  pingMonitor    PingMonitor   @relation(fields: [pingMonitorId], references: [id], onDelete: Cascade)
  pingRecipient  PingRecipient @relation(fields: [pingRecipientId], references: [id], onDelete: Cascade)

  @@id([pingMonitorId, pingRecipientId])
}

enum RecipientTargetType {
  contact
  group
  channel
  manual
}

enum ScheduleTargetMode {
  all
  group_only
  personal_only
}

/// groupId nullable: null means "dispatch ALL enabled groups".
model PrtgSchedule {
  id         Int                @id @default(autoincrement())
  name       String
  groupId    Int?
  group      PrtgGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  cron       String
  targetMode ScheduleTargetMode @default(all)
  enabled    Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

// ─── NOC Domain Models ───────────────────────────────────────────────────────

enum NocStatus {
  NORMAL
  LOW_TRAFFIC
  NO_TRAFFIC
  HIGH_UTILIZATION
  POSSIBLE_FLAPPING
  DOWN
  MAINTENANCE
}

enum NocSensitivity {
  LOW
  MEDIUM
  HIGH
}



// ─── Unified Monitoring History ──────────────────────────────────────────────

/// Monitoring history linked to PrtgConfig (replaces NocHistory linkage to NocMonitoredItem)
model MonitoringHistory {
  id                  Int        @id @default(autoincrement())
  configId            Int
  config              PrtgConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  timestamp           DateTime
  status              NocStatus
  totalTrafficBytes   Float?
  totalTrafficBitrate Float?
  inboundBytes        Float?
  inboundBitrate      Float?
  outboundBytes       Float?
  outboundBitrate     Float?
  errorPercent        Float?
  coveragePercent     Float?
  rawInboundBitrate   Float?
  rawOutboundBitrate  Float?
  errorMessage        String?
  rawResponse         String?    // Raw JSON response from PRTG (first entry only)
  createdAt           DateTime   @default(now())

  @@index([configId, timestamp])
  @@index([status])
}

// ─── Receipt Report ──────────────────────────────────────────────────────────

enum ReceiptPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model ReceiptSchedule {
  id                Int                @id @default(autoincrement())
  name              String
  groupId           Int?
  group             PrtgGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  cron              String
  period            ReceiptPeriod      @default(DAILY)
  includeDown       Boolean            @default(true)
  includeLowTraffic Boolean            @default(false)
  targetMode        ScheduleTargetMode @default(all)
  enabled           Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model ReceiptRecipient {
  id          Int                 @id @default(autoincrement())
  label       String?
  phoneNumber String
  targetType  RecipientTargetType @default(manual)
  enabled     Boolean             @default(true)
  groupId     Int?
  group       PrtgGroup?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}
